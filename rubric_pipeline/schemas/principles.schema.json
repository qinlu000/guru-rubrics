{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-grounded investment principles",
  "type": "object",
  "required": ["principles"],
  "properties": {
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["principle_id", "document_id", "claim", "principle_type", "source_support", "supporting_quotes"],
        "properties": {
          "principle_id": {"type": "string"},
          "document_id": {"type": "string"},
          "master": {"type": "string"},
          "claim": {"type": "string"},
          "principle_type": {"enum": ["selection", "valuation", "risk", "behavior", "portfolio", "capital_allocation", "governance", "other"]},
          "polarity": {"enum": ["required", "prohibited", "conditional"]},
          "conditions": {"type": "array", "items": {"type": "string"}},
          "exceptions": {"type": "array", "items": {"type": "string"}},
          "supporting_quotes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
          "source_support": {"enum": ["direct", "repeated", "strong_inference"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "corroborating_principle_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["quote"],
      "properties": {
        "quote": {"type": "string"},
        "span": {"$ref": "#/$defs/span"}
      },
      "additionalProperties": true
    },
    "span": {
      "description": "Character offsets [start, end) of the quote in the source text, computed by the pipeline.",
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 2,
      "maxItems": 2
    }
  }
}
