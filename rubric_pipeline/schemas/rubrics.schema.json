{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Framework-specific trading rubrics",
  "type": "object",
  "required": ["rubrics"],
  "properties": {
    "rubrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rubric_id", "principle_id", "framework_id", "criterion", "applicability", "source", "operationalization"],
        "properties": {
          "rubric_id": {"type": "string"},
          "principle_id": {"type": "string"},
          "framework_id": {"type": "string"},
          "criterion": {"type": "string"},
          "applicability": {
            "type": "object",
            "required": ["trigger", "decision_types", "required_context"],
            "properties": {
              "trigger": {"type": "string"},
              "decision_types": {"type": "array", "items": {"type": "string"}},
              "required_context": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          },
          "source": {
            "type": "object",
            "required": ["document_id", "exact_quotes"],
            "properties": {
              "document_id": {"type": "string"},
              "exact_quotes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "locators": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          },
          "operationalization": {
            "type": "object",
            "required": ["observable_behavior", "pass_if", "violate_if", "not_applicable_if", "not_observable_if", "evidence_to_quote"],
            "properties": {
              "observable_behavior": {"type": "string"},
              "pass_if": {"type": "string"},
              "violate_if": {"type": "string"},
              "not_applicable_if": {"type": "string"},
              "not_observable_if": {"type": "string"},
              "evidence_to_quote": {"type": "string"},
              "inference_level": {"enum": ["direct", "strong_inference", "operationalization"]}
            },
            "additionalProperties": true
          },
          "scoring": {"type": "object"},
          "axis": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  }
}
