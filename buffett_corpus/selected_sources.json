{
  "project": "buffett_investment_style_rubrics",
  "version": "0.1",
  "scope": {
    "author_boundary": "Warren Buffett's shareholder letters and Berkshire Hathaway's Owner's Manual, using official Berkshire Hathaway-hosted copies.",
    "primary_use": "Pilot corpus for extracting atomic, trajectory-observable investment-style rubrics.",
    "selection_logic": [
      "first-party and attributable",
      "explicit investment principles rather than only company reporting",
      "coverage of distinct decision dimensions",
      "repetition or later restatement where possible",
      "observable implications for a trading-agent trajectory"
    ],
    "excluded_for_now": [
      "secondary books and quote compilations",
      "commentary by other investors about Buffett",
      "company-specific passages with no transferable investment principle",
      "duplicated HTML/PDF copies of the same letter"
    ]
  },
