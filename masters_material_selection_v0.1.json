{
  "version": "0.1",
  "purpose": "为投资风格 Rubric 提取建立首批一手材料清单；先提取来源原则，再映射到 TradeBank 轨迹。",
  "selection_criteria": [
    "作者本人或其投资机构的原始表达",
    "有稳定的版本、日期和出处，可保留 source_url、edition 或 filing 标识",
    "能够覆盖估值、风险、组合、行为或交易决策，而不只是名言",
    "有机会从一位大师的材料中提取约 50–100 条原子化原则；实际数量需经去重和人工审查确认",
    "尽量覆盖不同风格，以避免首批语料全部集中在传统价值投资"
  ],
  "source_policy": {
    "canonical": "作者著作、作者署名的官方信件/演讲、投资机构官方股东信/研究和 SEC/公司披露。",
    "not_canonical": "二手名言汇编、媒体转述、未署名博客和读者整理的语录；可做线索，不能作为原则的唯一出处。",
    "copyright": "仓库只提交 metadata、官方 URL、版本/页码和 hash。受版权保护的书籍或受限 PDF 由研究者合法取得后在本地处理，不把全文提交到 GitHub。公开官方信件和网页也保留抓取日期、URL 与 hash，并遵守站点条款。",
    "source_types": {
      "official_open": "官方公开网页、信件、演讲或申报，可下载或抓取后保留出处",
      "licensed_book": "作者本人著作；需要合法购买、图书馆或用户提供的授权文本",
      "official_filing": "作者或其机构的官方年报、股东信或 SEC 文件",
      "official_institution": "作者任职机构公开的研究、投资说明或策略文件；需记录机构实体与署名"
    }
  },
